{
  "manifest_version": 3,
  "name": "SetupVPN Sweden Reconnector",
  "version": "1.8.5",
  "description": "Toolbar icon opens settings popup; Open dashboard sidebar for the panel. Auto bubble Sweden on Select location.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "management",
    "scripting",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.setupvpn.com/*",
    "https://chromewebstore.google.com/*",
    "https://chrome.google.com/webstore/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SetupVPN reconnector settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.setupvpn.com/*",
        "https://setupvpn.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://chromewebstore.google.com/*",
        "https://chrome.google.com/webstore/*"
      ],
      "js": [
        "webstore.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}

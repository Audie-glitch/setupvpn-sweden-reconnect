{
  "manifest_version": 3,
  "name": "SetupVPN Sweden Reconnector",
  "version": "1.4.0",
  "description": "Remember SetupVPN location and re-click it on disconnect. Prompts if SetupVPN is missing.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "management"
  ],
  "host_permissions": [
    "https://*.setupvpn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SetupVPN reconnector"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.setupvpn.com/ui/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "SetupVPN Sweden Reconnector",
  "version": "1.7.2",
  "description": "If enabled and on Select location, bubble the country (trusted click). Waits for list load; no forced userN login.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "management",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://*.setupvpn.com/*",
    "https://chromewebstore.google.com/*",
    "https://chrome.google.com/webstore/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SetupVPN reconnector"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.setupvpn.com/*",
        "https://setupvpn.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chromewebstore.google.com/*",
        "https://chrome.google.com/webstore/*"
      ],
      "js": [
        "webstore.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
